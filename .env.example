# Supabase (npx supabase status mostra os valores locais)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# URL pública do app, sem barra no final (na Vercel: https://seu-projeto.vercel.app)
APP_URL=http://localhost:3000

# 32 bytes em base64: openssl rand -base64 32
ENCRYPTION_KEY=

# Upstash QStash (local: npm run qstash:dev mostra token e chaves)
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Só no desenvolvimento local, com o servidor do qstash-cli:
# QSTASH_URL=http://127.0.0.1:8080

# Upstash Redis (local: docker compose -f docker-compose.dev.yml up -d)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Segredo do Vercel Cron (no mínimo 16 caracteres): openssl rand -hex 32
CRON_SECRET=

# Conta da demo, criada pelo npm run seed
DEMO_EMAIL=demo@hookbox.dev
DEMO_PASSWORD=
